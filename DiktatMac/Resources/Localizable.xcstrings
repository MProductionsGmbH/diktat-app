{
  "sourceLanguage": "de",
  "strings": {
    "\n\n\n---\nBitte oberhalb der Linie schreiben. Diese Angaben helfen uns beim Nachvollziehen, du kannst sie auch löschen:\n": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n\n---\nPlease write above the line. This information helps us understand the problem; you can delete it too:\n"
          }
        }
      }
    },
    " Ist Gemma geladen, nutzen Meetings es, wenn kein eigener Server gewählt ist. Gemma 4 von Google, Lizenz Apache 2.0.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Once Gemma is downloaded, meetings use it when no server of your own is chosen. Gemma 4 by Google, Apache 2.0 license."
          }
        }
      }
    },
    "%@ (%@)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)"
          }
        }
      }
    },
    "%@ (nicht installiert)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (not installed)"
          }
        }
      }
    },
    "%@ Bis dahin übernimmt der Modell-Anbieter unten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Until then, the model provider below takes over."
          }
        }
      }
    },
    "%@ Für die KI-Modi unten einen Modell-Anbieter mit API-Key hinterlegen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ For the AI modes below, add a model provider with an API key."
          }
        }
      }
    },
    "%@ Stattdessen mit Apple Intelligence zusammengefasst.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Summarized with Apple Intelligence instead."
          }
        }
      }
    },
    "%@ auf %@ ist eingerichtet. Meetings nutzen es erst, wenn bei KI-Modi „Immer Modell-Anbieter“ steht.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ at %@ is set up. Meetings only use it when AI modes is set to “Always model provider”."
          }
        }
      }
    },
    "%@ auf %@. Meetings, Glättung und KI-Modi nutzen es. Der Text verlässt den Mac nicht.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ at %@. Meetings, cleanup and AI modes use it. The text does not leave your Mac."
          }
        }
      }
    },
    "%@ auf diesem Mac konnte nicht zusammenfassen (%@). Läuft Ollama?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on this Mac could not summarize (%@). Is Ollama running?"
          }
        }
      }
    },
