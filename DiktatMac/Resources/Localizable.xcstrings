            "value": "Address"
          }
        }
      }
    },
    "Adresse der Website, zum Beispiel mail.google.com. Die Regel gilt auch für Unteradressen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address of the website, for example mail.google.com. The rule also covers subdomains."
