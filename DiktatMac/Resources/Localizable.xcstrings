    "Hallo Alex, es war wirklich schön, heute mit dir zu sprechen. Ich melde mich nächste Woche bezüglich des Termins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello Alex, it was really nice to speak with you today. I will get back to you next week regarding the appointment."
          }
        }
      }
    },
    "Halten": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
