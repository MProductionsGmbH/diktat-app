          }
        }
      }
    },
    "Hey Alex, es war wirklich schön, heute mit dir zu reden. Ich melde mich nächste Woche wegen des Termins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
