    "Diktat erkennt bei jedem Diktat selbst, ob du Deutsch oder Englisch sprichst. Wähle eine Sprache, wenn es bei kurzen Sätzen danebenliegt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat recognizes for every dictation whether you speak German or English. Pick a language if it gets short sentences wrong."
          }
        }
      }
    },
    "Diktat erkennt, wohin dein Text geht, und schreibt ihn im passenden Ton.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat recognizes where your text is going and writes it in the fitting tone."
          }
        }
      }
    },
    "Diktat hält sich über Sparkle aktuell.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat keeps itself up to date through Sparkle."
          }
