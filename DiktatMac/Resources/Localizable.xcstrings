    },
    "Bei langen Meetings dauert das ein paar Minuten, alles läuft auf diesem Mac. Beim ersten Mal lädt Diktat dazu einmalig das Modell für die Stimmen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For long meetings this takes a few minutes, everything runs on this Mac. The first time, Diktat downloads the model for the voices once."
          }
        }
      }
    },
    "Bei zugeklapptem MacBook ein Headset oder externes Mikrofon anschließen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the MacBook closed, connect a headset or an external microphone."
          }
        }
      }
    },
    "Beim Anmelden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
